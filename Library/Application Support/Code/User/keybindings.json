// Place your key bindings in this file to override the defaults
[
    // ****************************************************************
    // ** Visual Studio Code Key Bindings **
    // ****************************************************************
    // These key bindings are for macOS.
    // ****************************************************************
    // ** Sidebar/Primary Sidebar **
    // Toggle the primary sidebar (Explorer)
    {
        // Open Explorer and focus on it, if it is not already open. 
        // If it is open, focus on the Explorer view.
        "key": "cmd+shift+e",
        "command": "workbench.view.explorer",
    },
    {
        // Open Search and focus on it, if it is not already open.
        // If it is open, focus on the Search view.
        "key": "cmd+shift+f",
        "command": "workbench.view.search", // Search
    },
    {
        // Open Source Control and focus on it, if it is not already open.
        // If it is open, focus on the Source Control view.
        "key": "cmd+shift+g",
        "command": "workbench.view.scm", // Source Control
    },
    {
        // Open Debug and focus on it, if it is not already open.
        // If it is open, focus on the Debug view.
        "key": "cmd+shift+d",
        "command": "workbench.view.debug", // Debug
    },
    {
        // Close the primary sidebar (Explorer) and focus on the editor.
        // If the primary sidebar is already closed, focus on the editor.
        "key": "cmd+e",
        "command": "workbench.action.toggleSidebarVisibility",
    },
    // ** Secondary Sidebar/Auxiliary Bar **
    // Toggle the secondary sidebar (Auxiliary Bar)
    {
        // Open the secondary or auxiliary sidebar and focus on it, if it is not already open.
        // If it is open, focus on the secondary sidebar view.
        "key": "cmd+shift+b",
        "command": "workbench.action.focusAuxiliaryBar",
    },
    {
        // Close the secondary sidebar and focus on the editor.
        // If the secondary sidebar is already closed, focus on the editor.
        "key": "cmd+b",
        "command": "workbench.action.closeAuxiliaryBar",
    },
    {
        // Focus on the secondary sidebar (Auxiliary Bar) if it is opened.
        // If it is not opened, open it and focus on it.
        // If it is already open, focus on the secondary sidebar view.
        "key": "cmd+shift+\\",
        "command": "workbench.action.focusAuxiliaryBar",
    },
    {
        // Move back focus to the editor from the secondary sidebar (Auxiliary Bar).
        // If the secondary sidebar is open and focus is there then move to editor without closing it.
        "key": "cmd+\\",
        "command": "workbench.action.focusActiveEditorGroup",


    },
    {
        // Toggle the activity bar (the left sidebar with icons).
        // If the activity bar is already open, close it.
        "key": "cmd+k cmd+b",
        "command": "workbench.action.toggleActivityBarVisibility",
    },
    // ** Bottom Panel **
    // Toggle the bottom panel (terminal, output, problems, debug console)
    {
        // Open the bottom panel and focus on it, if it is not already open.
        // If it is open, focus on the bottom panel view.
        "key": "cmd+j",
        "command": "workbench.action.togglePanel",
    },
    {
        // Maximize or minimize the bottom panel.
        "key": "cmd+alt+j",
        "command": "workbench.action.toggleMaximizedPanel",
    },
    {
        // Close the bottom panel and focus on the editor.
        // If the bottom panel is already closed, focus on the editor.
        "key": "cmd+shift+j",
        "command": "workbench.action.closePanel",
    },
    // ** Command Palette **
    // Open the command palette (for running commands)
    {
        // Open the command palette and focus on it.
        "key": "cmd+shift+p",
        "command": "workbench.action.showCommands",
    },
    {
        // Open the command palette and focus on it.
        "key": "cmd+p",
        "command": "workbench.action.quickOpen",
    },
]