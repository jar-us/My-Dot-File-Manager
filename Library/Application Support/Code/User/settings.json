{
    /************************************************
     *           EDITOR APPEARANCE & BEHAVIOR       *
     ************************************************/
    // Font settings, cursor behavior, visual guides, etc.
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.fontFamily": "JetBrainsMono Nerd Font Mono",
    "editor.fontWeight": "bold",
    "editor.fontSize": 14,
    "editor.guides.bracketPairs": "active",
    "editor.find.addExtraSpaceOnTop": true,
    "editor.inlineSuggest.enabled": true,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.stickyScroll.enabled": true,
    "editor.hover.sticky": true,
    "editor.letterSpacing": 0.5,
    "editor.minimap.enabled": false,
    "editor.hover.delay": 1500,
    "editor.lineHeight": 1.5,
    "editor.renderLineHighlight": "gutter",
    "editor.smoothScrolling": true,
    /************************************************
     *           TEXT FORMATTING & DISPLAY          *
     ************************************************/
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "comment.block.documentation",
                    "comment.block.javadoc",
                    "comment.line.double-slash",
                    "comment.block",
                    "string.quoted.docstring"
                ],
                "settings": {
                    "foreground": "#2E7D32" // green color for comments
                }
            },
            {
                "scope": [
                    // Basic elements
                    "keyword",
                    "string",
                    "variable",
                    "constant",
                    // Package and imports
                    "storage.modifier.package",
                    "storage.modifier.import",
                    "entity.name.namespace",
                    "entity.name.class",
                    "entity.name.type.class",
                    "entity.name.type.class.java",
                    // Annotations
                    "storage.type.annotation",
                    "punctuation.definition.annotation",
                    "meta.annotation",
                    "meta.annotation.parameters",
                    "meta.annotation.parameters.java",
                    // Variables and declarations
                    "variable.other",
                    "variable.language",
                    "variable.parameter",
                    "variable.other.local",
                    "variable.other.object",
                    "variable.other.readwrite",
                    "variable.other.java",
                    // Keywords and types
                    "keyword.control",
                    "keyword.other",
                    "storage.type.primitive",
                    "storage.type.java",
                    "storage.modifier",
                    "storage.type",
                    "storage.type.class",
                    "storage.type.class.java",
                    // Function related
                    "entity.name.function",
                    "entity.name.type",
                    "entity.name.class",
                    "entity.name.method",
                    "entity.name.method.java",
                    "meta.function-call",
                    "meta.function-call.arguments",
                    "meta.function-call.parameters",
                    // Language constants
                    "constant.language.null",
                    "constant.language.boolean",
                    "constant.language.string",
                    "constant.language.number",
                    "constant.language.java",
                    "constant.language.character",
                    "constant.language.character.java",
                    // Support types
                    "support.type",
                    "support.class",
                    "support.class.java",
                    "support.function",
                    "support.function.java",
                    "support.variable",
                    "support.variable.java",
                    "support.variable.property",
                    "support.variable.property.java",
                    // Logging variables
                    "variable.other.object"
                ],
                "settings": {
                    "foreground": "#000000" // black color for everything else
                }
            }
        ]
    },
    "workbench.editorAssociations": {
        "*.md": "vscode.markdown.preview.editor", // always open markdown files in preview mode
    },
    /************************************************
     *           WINDOW & WORKBENCH LAYOUT          *
     ************************************************/
    "window.autoDetectColorScheme": true,
    "window.dialogStyle": "custom",
    "window.nativeTabs": true,
    "window.title": "${rootName}",
    "window.titleBarStyle": "custom",
    "window.zoomLevel": 1,
    "window.customTitleBarVisibility": "auto",
    "window.titleSeparator": " — ",
    "window.systemColorTheme": "dark",
    "workbench.layoutControl.type": "both",
    /************************************************
     *           SIDEBAR & PANEL CONFIGURATION      *
     ************************************************/
    "workbench.commandPalette.experimental.suggestCommands": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "workbench.fontAliasing": "antialiased",
    "workbench.iconTheme": "vs-minimal",
    "workbench.list.smoothScrolling": true,
    "workbench.startupEditor": "none",
    "workbench.tree.expandMode": "singleClick",
    "workbench.panel.defaultLocation": "bottom",
    "workbench.panel.opensMaximized": "preserve",
    "workbench.panel.showLabels": true,
    "workbench.editor.closeOnFileDelete": true,
    "workbench.view.alwaysShowHeaderActions": true,
    "workbench.activityBar.iconClickBehavior": "toggle",
    "workbench.editor.editorActionsLocation": "titleBar",
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "hidden",
    /************************************************
     *           COLOR CUSTOMIZATIONS               *
     ************************************************/
    "workbench.colorCustomizations": {
        "activityBar.background": "#d1e6c9",
        "activityBar.foreground": "#af5757",
        "activityBar.activeBorder": "#647885",
        "activityBar.badge.background": "#af5757",
        "activityBar.badge.foreground": "#ffffff",
        "statusBar.foreground": "#250101",
        "statusBar.background": "#42523c",
        "statusBar.debuggingBackground": "#cc6633",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.noFolderBackground": "#68217a",
        "statusBarItem.remoteBackground": "#16825d",
        "statusBarItem.remoteForeground": "#ffffff",
        "sideBar.background": "#9aa69d",
        "sideBar.foreground": "#1a1717",
        "sideBar.border": "#cccccc",
        "sideBarTitle.foreground": "#272525",
        "sideBarSectionHeader.background": "#908b8b",
        "sideBarSectionHeader.foreground": "#333333",
        "sideBarSectionHeader.border": "#ac0f0f",
        "panel.background": "#1e1e1e",
        "panel.border": "#80808059",
        "panelTitle.activeBorder": "#007ACC",
        "panelTitle.activeForeground": "#ffffff",
        "panelTitle.inactiveForeground": "#8e8e8e",
        "commandCenter.foreground": "#ffffff",
        "commandCenter.background": "#1e1e1e",
        "commandCenter.border": "#007acc",
        "commandCenter.activeBackground": "#2c2c2c",
        "commandCenter.activeForeground": "#ffffff",
        "commandCenter.inactiveForeground": "#969696",
        "commandCenter.inactiveBackground": "#2d2d2d",
        "quickInput.background": "#1e1e1e",
        "quickInput.foreground": "#ffffff",
        "quickInputList.focusBackground": "#2c2c2c",
        "quickInputList.focusForeground": "#f01414",
        "quickInputList.focusIconForeground": "#007acc",
        "quickInputTitle.background": "#1e1e1e",
        "titleBar.activeBackground": "#2C2C2C",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#1f1f1f",
        "titleBar.inactiveForeground": "#8e8e8e",
        "titleBar.border": "#007acc",
        "window.activeBorder": "#d31020",
        "window.inactiveBorder": "#35815e",
        "focusBorder" : "#007acc",
        
    },
    /************************************************
     *           GIT & SOURCE CONTROL               *
     ************************************************/
    "git.autofetch": true,
    "scm.diffDecorationsGutterWidth": 5,
    /************************************************
     *           TERMINAL CONFIGURATION             *
     ************************************************/
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.fontWeight": "bold",
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.fontSize": 10,
    /************************************************
     *           EXTENSIONS & INTEGRATIONS          *
     ************************************************/
    "diffEditor.hideUnchangedRegions.enabled": true,
    "redhat.telemetry.enabled": true,
    "github.copilot.nextEditSuggestions.enabled": false,
    "jupyter.askForKernelRestart": false,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "debug.enableStatusBarColor": true,
}